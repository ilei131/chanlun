# .env - 环境配置文件
# 请根据实际情况修改以下配置

# Server Configuration
HOST=0.0.0.0
PORT=8090
API_PREFIX=/api/v1

# Database Configuration
DB_PROTOCOL=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=ilei
DB_PASSWORD=123456
DB_NAME=chanlun

# Logging Configuration
RUST_LOG=info

# Security Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_HOURS=24

# Admin Configuration
ADMIN_DEFAULT_PASSWORD=123456

# Tushare Configuration
# 请在这里填入你的 tushare token（从 https://tushare.pro 注册获取）
TUSHARE_TOKEN=
TUSHARE_APP_ID=chanlun_server

# Data Collector Configuration
DATA_CACHE_DIR=./data_cache
HISTORY_START_DATE=20100101
